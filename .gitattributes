# Normalize line endings for cross-platform evaluation
* text=auto

# Force LF for all source and config files
*.py  text eol=lf
*.sh  text eol=lf
*.md  text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.toml text eol=lf
*.cfg  text eol=lf

# Windows batch files stay CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets - no line-ending processing
*.png binary
*.jpg binary
*.pdf binary
