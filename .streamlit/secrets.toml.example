# Copy to .streamlit/secrets.toml locally (NEVER commit the real file),
# or paste this content into Streamlit Cloud → App → Settings → Secrets.
GEMINI_API_KEY = "your-active-gemini-api-key-here"

# Standby/rotation key — verified and ready before the active key is revoked
# GEMINI_STANDBY_API_KEY = "your-standby-gemini-api-key-here"

# Optional: pin a different model
# GEMINI_MODEL = "gemini-2.5-flash"
